<a class="card product-card" href="/product/<%= p.slug %>">
  <div class="thumb">
    <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } else { %><span><%= p.name.charAt(0) %></span><% } %>
  </div>
  <div class="card-body">
    <h3><%= p.name %></h3>
    <p class="muted small"><%= p.store_name %></p>
    <p class="price"><%= money(p.price) %></p>
    <p class="small">
      <% if (p.review_count) { %><span class="stars">★ <%= p.avg_rating %></span> <span class="muted">(<%= p.review_count %>)</span><% } %>
      <% if (p.stock <= 0) { %><span class="tag tag-red">Out of stock</span><% } %>
    </p>
  </div>
</a>
