<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>
<section class="card form-card">
  <h2>Marketplace settings</h2>
  <form method="post" action="/admin/settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Commission per sale (%) <input type="number" name="commission_percent" step="0.1" min="0" max="100" value="<%= commission %>" required></label>
    <p class="muted small">The marketplace keeps this percentage of every item sold. Changes apply to new orders only.</p>
    <button class="btn">Save</button>
  </form>
</section>
<%- include('../partials/footer') %>
